CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=6144
CONFIG_FREERTOS_HZ=1000

# 16MB flash (ESP32-S3-WROOM-1-N16R8)；分区表 partitions.csv 由 espflash 烧录时写入（见 espflash.toml）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 故意不启用 PSRAM：N16R8 的八线 PSRAM 占用 GPIO35/36/37，
# 不初始化 PSRAM 这三个脚才能给 H8/H9/H10 灯带口用。
# CONFIG_SPIRAM is not set

# 不能开 CONFIG_RMT_ISR_IRAM_SAFE：esp-idf-hal 的 Rust 回调不在 IRAM，
# 开了之后创建 RMT 通道会报 ESP_ERR_INVALID_ARG。

# 上电时 WiFi 发射电流大，降低最大发射功率减轻 3.3V 供电压力（HT7533 只有 100mA）
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=11

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_LWIP_LOCAL_HOSTNAME="ledctl"
